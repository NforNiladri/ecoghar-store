# For hosting, add these in your host's "Environment" settings. For testing on your own computer, copy this file to .env.
# Never share or upload your real values.
NODE_ENV=production

# Your admin login (created the first time the server starts). Use a long, unique password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-to-a-long-password

# Free hosted database (Turso). Leave both empty to use a local file when testing on your computer.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Google Sheet sync.
# SHEET_ID is the long ID in the sheet's address: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# The whole service-account key file as ONE line of JSON (see README).
GOOGLE_SERVICE_ACCOUNT_JSON=
